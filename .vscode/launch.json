{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "백엔드 (Flask)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/backend/app.py",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/venv/Scripts/python.exe",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "프론트엔드 (React)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    },
    {
      "name": "크롤링 실행",
      "type": "debugpy",
      "request": "launch",
      "module": "crawler.run",
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/venv/Scripts/python.exe",
      "env": { "PYTHONIOENCODING": "utf-8" },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "▶ 전체 실행 (백엔드 + 프론트엔드)",
      "configurations": ["백엔드 (Flask)", "프론트엔드 (React)"],
      "stopAll": true
    }
  ]
}
